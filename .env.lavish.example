# Lavish session storage — copy ONE of these (gitignored), never commit secrets:
#
#   Cross-project (recommended):  ~/.lavish-axi/env.local
#   Per-repo:                     .env.lavish.local  (in any project cwd tree)
#   Explicit path:                export LAVISH_AXI_ENV_FILE=~/.lavish-axi/env.local
#
#   cp .env.lavish.example ~/.lavish-axi/env.local

# Mongo (database name from URL path)
LAVISH_AXI_STORE=mongodb://localhost:27017/confluence

# Optional DB override
# LAVISH_AXI_STORE_DB=lavish_axi

# Or alias + shared URL
# LAVISH_AXI_STORE=mongo
# MONGODB_URL=mongodb://localhost:27017/confluence

# File (default) or SQLite
# LAVISH_AXI_STORE=file
# LAVISH_AXI_STORE=sqlite
